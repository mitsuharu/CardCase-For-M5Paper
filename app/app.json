{
  "expo": {
    "name": "CardCase",
    "slug": "cardcase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "net.mituwa.cardcase",
      "infoPlist": {
        "NFCReaderUsageDescription": "M5Paper に画像を送るために NFC を使います。",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "TAG"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.mituwa.cardcase",
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "M5Paper に画像を送るために NFC を使います。"
        }
      ]
    ],
    "scheme": "cardcase",
    "extra": {
      "eas": {
        "projectId": "03c8a4d2-9ee7-4f5e-941f-3766154a59a3"
      }
    }
  }
}
